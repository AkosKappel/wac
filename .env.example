# Development settings. Copy to .env (chmod 600). Never commit .env.
# Production runs from ~/deploy/ambulance with its own settings (deploy/.env.example).

# --- Compose ---
CONTAINER_PREFIX=wac-dev
# Image tag to run from GHCR: latest (main) or sha-<short commit>. An image built here
# should set its own tag, e.g. dev, so it never shares a name with a published one.
#IMAGE_TAG=dev
APP_BIND=127.0.0.1
# The server's staging ports, so the dev stack never collides with production (8084)
APP_PORT=8081
# MongoDB for local tools such as Compass (mongodb://root:<password>@127.0.0.1:27018)
DB_HOST_PORT=27018

# --- MongoDB (users are created only when the volume is first created) ---
# root: admin work only
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
# app user for the API and the reset job, readWrite on the app database only
AMBULANCE_API_MONGODB_USERNAME=ambulance
AMBULANCE_API_MONGODB_PASSWORD=
AMBULANCE_API_MONGODB_DATABASE=harkap-ambulance
AMBULANCE_API_MONGODB_COLLECTION=ambulance

# --- Demo ---
DEMO_RESET_TIME=03:30
DEMO_RESET_TIMEZONE=Europe/Bratislava
