# Copy to .env (chmod 600). Never commit .env.

# --- Compose ---
CONTAINER_PREFIX=ambulance
# On the server, also load the Tailscale sidecar:
#COMPOSE_FILE=docker-compose.yaml:docker-compose.tailscale.yml
# nginx also writes its access log here; the server points it at ~/logs/<app> for
# the traffic dashboard (absolute path). Default: ./tmp/nginx
#ACCESS_LOG_DIR=/home/akap/logs/ambulance
# Image tag to run from GHCR: latest (main) or sha-<short commit>. A staging copy built
# locally should set its own tag so it does not replace the live images.
#IMAGE_TAG=latest
APP_BIND=127.0.0.1
APP_PORT=8084
# MongoDB for local tools such as Compass (mongodb://root:<password>@127.0.0.1:27019)
DB_HOST_PORT=27019

# --- MongoDB (users are created only when the volume is first created) ---
# root: admin work only
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
# app user for the API and the reset job, readWrite on the app database only
AMBULANCE_API_MONGODB_USERNAME=ambulance
AMBULANCE_API_MONGODB_PASSWORD=
AMBULANCE_API_MONGODB_DATABASE=harkap-ambulance
AMBULANCE_API_MONGODB_COLLECTION=ambulance

# --- Demo ---
DEMO_RESET_TIME=03:30
DEMO_RESET_TIMEZONE=Europe/Bratislava
