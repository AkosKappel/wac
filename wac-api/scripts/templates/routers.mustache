{{>partial_header}}
package {{packageName}}

import (
    "github.com/gin-gonic/gin"
)

func AddRoutes(engine *gin.Engine, deps Dependencies) {
  group := engine.Group("{{{basePathWithoutHost}}}")
  {{#apiInfo}}{{#apis}}
  {
    api := new{{classname}}(deps)
    api.addRoutes(group)
  }
  {{/apis}}{{/apiInfo}}
}