{
  "name": "ambulance-ufe",
  "version": "0.0.1",
  "description": "Micro-frontend for the register of medical devices in hospital departments",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.js",
  "es2017": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/ambulance-ufe/ambulance-ufe.esm.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/AkosKappel/wac.git",
    "directory": "wac-ufe"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "convert-openapi": "js-yaml ../wac-api/api/ambulance-wl.openapi.yaml > .openapi.json",
    "mock-api": "open-api-mocker --schema .openapi.json --port 5555",
    "start:app": "stencil build --dev --watch --serve",
    "start:mock": "run-s convert-openapi mock-api",
    "start": "run-p -r start:mock start:app",
    "build": "stencil build",
    "test": "stencil test --spec --e2e --max-workers=1",
    "test:spec": "stencil test --spec --max-workers=1",
    "test:e2e": "stencil test --e2e --max-workers=1",
    "test.watch": "stencil test --spec --e2e --max-workers=1 --watchAll",
    "generate": "stencil generate",
    "openapi": "../scripts/generate-api.sh",
    "test:jest": "jest --config ./jest.config.js",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "@stencil/core": "^4.45.1",
    "@stencil/store": "^2.2.4",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.3",
    "@types/jest": "^29.5.6",
    "@types/node": "^24.19.0",
    "axe-core": "^4.14.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "js-yaml": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "open-api-mocker": "^2.0.0",
    "prettier": "^3.9.9",
    "puppeteer": "^25.11.0"
  },
  "license": "MIT",
  "allowScripts": {
    "puppeteer@25.11.0": true
  }
}
