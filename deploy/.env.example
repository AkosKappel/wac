# Production settings for deploy/compose.yaml. Copy to .env in the deploy folder, chmod 600.
COMPOSE_FILE=compose.yaml:compose.tailscale.yaml

# The images to run: a commit tag from GHCR (sha-1234567), set by deploy.sh.
IMAGE_TAG=sha-0000000

# Local access on the server (infra/hosting/ports.md)
APP_PORT=8084
# nginx's access log for the traffic dashboard (absolute path)
ACCESS_LOG_DIR=/home/akap/logs/ambulance

# MongoDB (the passwords apply only when the volume is first created)
# root: admin work only
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
# app user for the API and the reset job, readWrite on the app database only
AMBULANCE_API_MONGODB_USERNAME=ambulance
AMBULANCE_API_MONGODB_PASSWORD=
AMBULANCE_API_MONGODB_DATABASE=harkap-ambulance
AMBULANCE_API_MONGODB_COLLECTION=ambulance

# Nightly demo reset
DEMO_RESET_TIME=03:30
DEMO_RESET_TIMEZONE=Europe/Bratislava
